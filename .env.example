########################################
# AFitCenter - variaveis de ambiente
#
# Atalho para desenvolvimento: ./scripts/gerar-env-local.sh gera um .env.local completo,
# com segredos aleatorios e um par de chaves ES256 novos.
#
# Nunca versione .env.local, .env.homolog, .env.prod ou qualquer arquivo com segredos.
########################################

# "local" carrega os dados ficticios, o Swagger e os logs detalhados. Vazio = configuracao segura.
SPRING_PROFILES_ACTIVE=

# =====================================
# PORTAS (publicadas no host pelos overlays)
# =====================================
GATEWAY_PORT=8080
EUREKA_PORT=8761
RABBITMQ_MANAGEMENT_PORT=15672
# Somente compose.dev.yml
POSTGRES_HOST_PORT=5432
RABBITMQ_PORT=5672
# Interface das portas publicadas (padrao 127.0.0.1)
PUBLISH_ADDRESS=
GATEWAY_BIND_ADDRESS=

# =====================================
# EUREKA (basic auth; use valores seguros em URL, ex.: openssl rand -hex 24)
# =====================================
EUREKA_USER=
EUREKA_PASSWORD=
# Somente fora do Docker: http://<EUREKA_USER>:<EUREKA_PASSWORD>@localhost:8761/eureka/
EUREKA_URL=

# =====================================
# RABBITMQ
# =====================================
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# =====================================
# POSTGRESQL (um banco e um usuario por microsservico)
# =====================================
POSTGRES_ADMIN_USER=afit_admin
POSTGRES_ADMIN_PASSWORD=

AUTH_DB_NAME=afit_auth
AUTH_DB_USER=afit_auth
AUTH_DB_PASSWORD=

NUTRICIONISTA_DB_NAME=afit_nutricionista
NUTRICIONISTA_DB_USER=afit_nutricionista
NUTRICIONISTA_DB_PASSWORD=

PACIENTE_DB_NAME=afit_paciente
PACIENTE_DB_USER=afit_paciente
PACIENTE_DB_PASSWORD=

CONSULTA_DB_NAME=afit_consulta
CONSULTA_DB_USER=afit_consulta
CONSULTA_DB_PASSWORD=

AVALIACAO_DB_NAME=afit_avaliacao
AVALIACAO_DB_USER=afit_avaliacao
AVALIACAO_DB_PASSWORD=

DIETA_DB_NAME=afit_dieta
DIETA_DB_USER=afit_dieta
DIETA_DB_PASSWORD=

PLANOS_DB_NAME=afit_planos
PLANOS_DB_USER=afit_planos
PLANOS_DB_PASSWORD=

PAGAMENTOS_DB_NAME=afit_pagamentos
PAGAMENTOS_DB_USER=afit_pagamentos
PAGAMENTOS_DB_PASSWORD=

AUDITORIA_DB_NAME=afit_auditoria
AUDITORIA_DB_USER=afit_auditoria
AUDITORIA_DB_PASSWORD=

# =====================================
# JWT E COMUNICACAO INTERNA
# =====================================
AFIT_JWT_ISSUER=afitcenter
# Par ECDSA P-256 (ES256), DER em Base64 numa linha (PEM tambem e aceito).
# A PRIVADA fica so no ms-autenticacao; Gateway e servicos recebem apenas a PUBLICA.
#   openssl ecparam -name prime256v1 -genkey -noout -out jwt.pem
#   openssl pkcs8 -topk8 -nocrypt -in jwt.pem -outform DER | base64 -w0   -> AFIT_JWT_PRIVATE_KEY
#   openssl ec -in jwt.pem -pubout -outform DER | base64 -w0              -> AFIT_JWT_PUBLIC_KEY
AFIT_JWT_PRIVATE_KEY=
AFIT_JWT_PUBLIC_KEY=
# Validade do token de acesso, em minutos
AFIT_TOKEN_VALIDADE_MINUTOS=15
# Token das chamadas servico-a-servico (o Gateway nao o usa). openssl rand -hex 32
AFIT_INTERNAL_TOKEN=

# =====================================
# SEGURANCA
# =====================================
# Origens autorizadas a chamar o Gateway pelo navegador (separadas por virgula).
# Comentada = padrao do perfil (local libera http://localhost:5173).
# AFIT_CORS_ALLOWED_ORIGINS=
AFIT_LOGIN_MAX_FALHAS=5
AFIT_LOGIN_BLOQUEIO_MINUTOS=15

# =====================================
# ASSINATURAS E PAGAMENTOS
# =====================================
# Provedor das novas cobrancas: SIMULADO (nenhuma cobranca e real) ou ASAAS (exige o Asaas habilitado).
# Depois de trocar, mantenha o anterior configurado: as cobrancas antigas continuam nele.
AFIT_PAGAMENTOS_PROVEDOR=SIMULADO
# Segredo do HMAC das notificacoes do simulador (16+ caracteres). openssl rand -hex 32
AFIT_PAGAMENTOS_WEBHOOK_SEGREDO=
# Asaas (so o container do ms-pagamentos recebe). Chave em Integracoes > Chaves de API no painel do Asaas.
AFIT_PAGAMENTOS_ASAAS_HABILITADO=false
# Sandbox: https://api-sandbox.asaas.com/v3 | Producao: https://api.asaas.com/v3
AFIT_PAGAMENTOS_ASAAS_URL=https://api-sandbox.asaas.com/v3
# Entre aspas simples: a chave comeca com $ e, sem elas, o Compose a trata como variavel.
# AFIT_PAGAMENTOS_ASAAS_CHAVE_API='$aact_...'
AFIT_PAGAMENTOS_ASAAS_CHAVE_API=
# Token de autenticacao do webhook (32+ caracteres), o mesmo cadastrado no webhook do Asaas, que aponta para
# <gateway>/ms-pagamentos/v1/webhooks/asaas. openssl rand -hex 32
AFIT_PAGAMENTOS_ASAAS_TOKEN_WEBHOOK=
# Dias para pagar a cobranca de uma mudanca de plano
PLANOS_DIAS_VENCIMENTO=3
# A renovacao e cobrada esta quantidade de dias antes do fim do periodo pago
PLANOS_DIAS_ANTECEDENCIA_RENOVACAO=7
# Dias como inadimplente (limites mantidos) antes da suspensao (limites do plano gratuito)
PLANOS_DIAS_CARENCIA=7

# =====================================
# AUDITORIA
# =====================================
# Registros mais antigos que isto sao apagados (0 = guardar para sempre)
AUDITORIA_RETENCAO_DIAS=1825

# =====================================
# DOCKER (opcionais)
# =====================================
IMAGE_REGISTRY=
IMAGE_TAG=
